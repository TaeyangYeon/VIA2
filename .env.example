# VIA2 Environment Configuration
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ── Backend server ──────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── AI Engine mode ──────────────────────────────────────────
# "local"  → uses Ollama running on this machine
# "remote" → uses the Colab/Azure URL below
ENGINE_MODE=local

# ── Local Ollama (used when ENGINE_MODE=local) ──────────────
OLLAMA_URL=http://localhost:11434

# ── Remote GPU server (used when ENGINE_MODE=remote) ────────
# Paste your Colab Cloudflare tunnel URL here, e.g.:
#   REMOTE_AI_URL=https://xxxx.trycloudflare.com
REMOTE_AI_URL=

# ── Logging ─────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Pipeline ────────────────────────────────────────────────
# Maximum Vision Judge retry iterations before the Decision Agent runs
MAX_ITERATIONS=3

# ── Storage ─────────────────────────────────────────────────
# Directory for temporary uploaded images and render artifacts
TEMP_DIR=/tmp/via2
